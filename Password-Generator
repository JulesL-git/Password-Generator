import secrets
import string
length = int(input('Enter length of password: '))

def generate_password(length: int = 10):
    alphabet = string.ascii_letters + string.digits + string.punctuation
    password = ''
    new_password = []
    selected_letter = []
    password_list = []
    password += secrets.choice(string.ascii_lowercase)
    password += secrets.choice(string.ascii_uppercase)
    password += secrets.choice(string.digits)
    password += secrets.choice(string.punctuation)
    
     if length <= 4:
        print('length must be greater than 4')
        return exit()
        
    while len(password) < length:
        password += secrets.choice(alphabet)

    for i in password:
        password_list += i
    print(f'password_list {password_list}')
    
    for _ in password:
        selected_letter = secrets.choice(password_list)
        print(f'selected_letter: {selected_letter}')
        new_password.append(selected_letter)
        password_list.remove(selected_letter)
        print(f'password_list:  {password_list}')
        print(f'new_password:  {new_password}')
        print(len(new_password))
        
    new_password = ''.join(new_password)
    
    if new_password == password:
        print('Password is invalid')
        return generate_password(length)
    else:
        print(f'shuffled:  {new_password}')
        print(f'unshuffled:  {password}')
        return new_password


generate_password(length)
